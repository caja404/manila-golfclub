{
  "name": "mgc-caddie-dispatch",
  "version": "0.1.0",
  "private": true,
  "description": "Manila Golf Club caddie dispatch and queue management (POC)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "seed": "tsx server/seed-cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "fastify": "^5.12.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  },
  "engines": {
    "node": ">=22.13"
  }
}
